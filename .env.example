# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local (docker compose): mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
MONGO_DB=cognifetch

# ─── API server ───────────────────────────────────────────────────────────────
PORT=3500
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ─── Ingestion ────────────────────────────────────────────────────────────────
# arXiv OAI-PMH endpoint (bulk-harvest host). Do not change unless mirroring.
ARXIV_OAI_ENDPOINT=https://export.arxiv.org/oai2
# OAI-PMH set(s) to harvest, comma-separated (e.g. cs, math, stat).
ARXIV_SETS=cs,stat
# Hard cap on documents to harvest.
HARVEST_LIMIT=15000
# Politeness delay between arXiv requests, milliseconds (ToS: >= 3000).
ARXIV_REQUEST_DELAY_MS=3100

# ─── OCR pipeline ─────────────────────────────────────────────────────────────
# Number of held-out papers to turn into synthetic scanned PDFs.
OCR_SYNTH_COUNT=2500
# Worker concurrency for Tesseract OCR.
OCR_CONCURRENCY=4

# ─── Web (apps/web, build-time) ───────────────────────────────────────────────
# Base URL of the API the browser calls.
VITE_API_BASE_URL=http://localhost:3500
